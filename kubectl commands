/etc/kubernetes/manifests	Static Pods
/etc/kubernetes/pki	Certificates
/etc/cni/net.d	CNI configs
/opt/cni/bin	CNI binaries
/var/lib/kubelet	Kubelet data/config
/var/lib/etcd	etcd database
/var/lib/containerd	containerd data
/run/containerd	containerd socket/runtime
~/.kube/config	kubectl config
















